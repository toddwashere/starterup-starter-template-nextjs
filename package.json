{
  "name": "superpowers-starter-template",
  "private": true,
  "license": "MIT",
  "author": "Todd Fisher",
  "engines": {
    "node": ">=24.16.0"
  },
  "scripts": {
    "dev": "tsx scripts/ensure-next-dev-cache.ts && dotenv -- turbo run dev",
    "build": "dotenv -- turbo run build",
    "lint": "dotenv -- turbo run lint",
    "type-check": "dotenv -- turbo run type-check",
    "test": "dotenv -- turbo run test",
    "test:e2e": "pnpm --filter @apps/dashboard test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "clean": "turbo run clean",
    "eval:ai": "echo '⚠️  LIVE LLM CALLS — uses API tokens. Cached reruns are free. See evals/promptfoo/README.md' && dotenv -- npx promptfoo@latest eval -c evals/promptfoo/assistant-chat/promptfooconfig.yaml",
    "eval:ai:view": "npx promptfoo@latest view",
    "eval:ai:live": "echo '⚠️  LIVE LLM CALLS — bypassing cache (--no-cache). See evals/promptfoo/README.md' && dotenv -- npx promptfoo@latest eval -c evals/promptfoo/assistant-chat/promptfooconfig.yaml --no-cache",
    "validate:env": "tsx scripts/validate-env.mts",
    "check:credit-conventions": "tsx scripts/check-credit-conventions.ts",
    "infra:init:profile": "tsx scripts/infra-init.ts",
    "infra:init": "dotenv -e infra/.env.local -- tsx infra/scripts/infra.ts init",
    "infra:configure": "dotenv -e infra/.env.local -- tsx infra/scripts/configure.ts",
    "infra:secrets:status": "dotenv -e infra/.env.local -- tsx infra/scripts/secrets.ts status",
    "infra:secrets:set": "dotenv -e infra/.env.local -- tsx infra/scripts/secrets.ts set",
    "infra:deploy": "dotenv -e infra/.env.local -- tsx infra/scripts/infra.ts deploy",
    "infra:preview": "dotenv -e infra/.env.local -- tsx infra/scripts/infra.ts preview",
    "infra:destroy": "dotenv -e infra/.env.local -- tsx infra/scripts/infra.ts destroy",
    "infra:test:ephemeral": "dotenv -e infra/.env.local -- tsx infra/scripts/infra.ts ephemeral",
    "infra:aws": "dotenv -e infra/.env.local -- tsx infra/aws/scripts/aws.ts",
    "infra:aws:state": "dotenv -e infra/.env.local -- tsx infra/aws/scripts/state-bootstrap.ts",
    "infra:public-urls": "tsx infra/shared/scripts/print-public-urls.ts",
    "test:infra": "vitest run --config infra/vitest.config.ts",
    "test:scripts": "vitest run --config scripts/vitest.config.ts"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "@workspace/tooling": "workspace:*",
    "dotenv": "^16",
    "dotenv-cli": "^11.0.0",
    "prettier": "^3.4",
    "tsx": "^4",
    "turbo": "^2.9.14",
    "typescript": "^5.7",
    "vitest": "^3.2.7",
    "zod": "^3"
  },
  "packageManager": "pnpm@11.1.3",
  "pnpm": {
    "overrides": {
      "minimatch@3>brace-expansion": "1.1.12"
    }
  }
}
