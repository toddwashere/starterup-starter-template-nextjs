# syntax=docker/dockerfile:1
#
# Multi-stage build for @apps/www. Uses Turborepo "prune" to bring
# only the www package + workspace deps into the image, then builds
# Next.js with output: "standalone" and runs the minimal server.
#
# Build context must be the repo root:
#   docker build -f infra/shared/docker/Dockerfile.www -t www .
#
# www pulls @workspace/database transitively (campaigns email routes), so Prisma
# client must be generated before `next build`.

# ---------------------------------------------------------------------------
# Stage 1: prune the monorepo down to @apps/www + its dependencies.
# ---------------------------------------------------------------------------
FROM node:24.16.0-slim AS pruner
WORKDIR /app
RUN corepack enable
COPY . .
RUN npx --yes turbo@^2 prune @apps/www --docker

# ---------------------------------------------------------------------------
# Stage 2: install deps and build Next.js standalone.
# ---------------------------------------------------------------------------
FROM node:24.16.0-slim AS builder
WORKDIR /app
RUN corepack enable

# Install dependencies using only the pruned lockfile + package manifests so
# this layer is cached unless a manifest changes.
COPY --from=pruner /app/out/json/ .
RUN pnpm install --frozen-lockfile

# Copy the pruned source.
COPY --from=pruner /app/out/full/ .

# Generate Prisma client (placeholder URL only satisfies config load).
RUN DATABASE_URL="postgresql://placeholder:placeholder@localhost:5432/placeholder" \
    pnpm --filter @workspace/database exec prisma generate

# NEXT_PUBLIC_* are inlined at build time. Defaults unblock CI/local image
# builds; pass real App Runner / custom-domain URLs via --build-arg for prod.
ARG NEXT_PUBLIC_DASHBOARD_URL=http://localhost:4000
ARG NEXT_PUBLIC_WWW_URL=http://localhost:4001
ARG NEXT_PUBLIC_API_URL=http://localhost:4002
ARG NEXT_PUBLIC_MCP_URL=http://localhost:4003
ENV NEXT_PUBLIC_DASHBOARD_URL=$NEXT_PUBLIC_DASHBOARD_URL \
    NEXT_PUBLIC_WWW_URL=$NEXT_PUBLIC_WWW_URL \
    NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_MCP_URL=$NEXT_PUBLIC_MCP_URL \
    DATABASE_URL=postgresql://placeholder:placeholder@localhost:5432/placeholder \
    BETTER_AUTH_SECRET=build-time-placeholder-secret-32chars \
    BETTER_AUTH_URL=$NEXT_PUBLIC_DASHBOARD_URL \
    STRIPE_SECRET_KEY=sk_test_build_placeholder \
    STRIPE_WEBHOOK_SECRET=whsec_build_placeholder \
    CAMPAIGN_UNSUBSCRIBE_SECRET=build-time-campaign-unsubscribe-secret-32

# Build Next.js with standalone output enabled.
RUN pnpm --filter @apps/www build \
    && mkdir -p apps/www/public

# ---------------------------------------------------------------------------
# Stage 3: minimal runtime image using the Next.js standalone output.
# ---------------------------------------------------------------------------
FROM node:24.16.0-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=4001
ENV HOSTNAME=0.0.0.0

# Next standalone emits a self-contained server.js + trimmed node_modules
# under .next/standalone/. Copy that tree plus the static assets and public
# dir that standalone does not bundle.
COPY --from=builder /app/apps/www/.next/standalone ./
COPY --from=builder /app/apps/www/.next/static ./apps/www/.next/static
COPY --from=builder /app/apps/www/public ./apps/www/public

EXPOSE 4001
CMD ["node", "apps/www/server.js"]
