# Infra operator secrets — NOT for app runtime.
#
# Copy to infra/.env.local (gitignored) and fill in values:
#   cp infra/.env.example infra/.env.local
#
# Root `.env` is for local app dev (docker-compose, turbo). Keep infra credentials
# separate so deploy tooling never mixes with app secrets.
#
# Load before infra commands (either works):
#   set -a && source infra/.env.local && set +a
#   # or rely on package.json scripts (they auto-load infra/.env.local via dotenv-cli)

# ── GCP (self-managed GCS state backend) ─────────────────────────
# Required for `pnpm infra:init`, `infra:deploy`, `infra:preview`, etc.
# Encrypts secrets stored in Pulumi stack state on gs://<project>-pulumi-state.
# Use ONE team passphrase for all GCP envs/layers on this backend — store in a
# password manager; reuse the same value in GitHub Actions (PULUMI_CONFIG_PASSPHRASE).
#
# Option A — passphrase in this file (simplest locally):
# PULUMI_CONFIG_PASSPHRASE=

# Option B — passphrase in a file (avoids putting it in .env.local):
# PULUMI_CONFIG_PASSPHRASE_FILE=infra/.pulumi-passphrase
# Create with: openssl rand -base64 32 > infra/.pulumi-passphrase && chmod 600 infra/.pulumi-passphrase

# Optional override for state bucket region (default us-central1 in orchestrator):
# GCP_REGION=us-central1

# ── AWS / Azure (Pulumi Cloud backend) ───────────────────────────
# These profiles use Pulumi SaaS state — no passphrase. Set when running
# `pulumi up` under infra/aws/* or infra/azure/*, or in GitHub Actions:
# PULUMI_ACCESS_TOKEN=
