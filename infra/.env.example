# Infra operator secrets — NOT for app runtime.
#
# Copy to infra/.env.local (gitignored) and fill in values:
#   cp infra/.env.example infra/.env.local
#
# Root `.env` is for local app dev (docker-compose, turbo). Keep infra credentials
# separate so deploy tooling never mixes with app secrets.
#
# Load before infra commands (either works):
#   set -a && source infra/.env.local && set +a
#   # or rely on package.json scripts (they auto-load infra/.env.local via dotenv-cli)

# ── GCP (self-managed GCS state backend) ─────────────────────────
# Required for `pnpm infra:init`, `infra:deploy`, `infra:preview`, etc.
# Encrypts secrets stored in Pulumi stack state on gs://<project>-pulumi-state.
# Use ONE team passphrase for all GCP envs/layers on this backend — store in a
# password manager; reuse the same value in GitHub Actions (PULUMI_CONFIG_PASSPHRASE).
#
# Option A — passphrase in this file (simplest locally):
# PULUMI_CONFIG_PASSPHRASE=

# Option B — passphrase in a file (avoids putting it in .env.local):
# PULUMI_CONFIG_PASSPHRASE_FILE=infra/.pulumi-passphrase
# Create with: openssl rand -base64 32 > infra/.pulumi-passphrase && chmod 600 infra/.pulumi-passphrase

# Optional override for state bucket region (default us-central1 in orchestrator):
# GCP_REGION=us-central1

# ── Pulumi backends ───────────────────────────────────────────────
# Azure uses Pulumi Cloud. AWS uses the dedicated-account S3/KMS backend
# initialized by `pnpm infra:aws:state`; GCP uses its own GCS backend.
# Set this only for profiles that use Pulumi Cloud:
# PULUMI_ACCESS_TOKEN=

# DIY backends always use the literal `organization` as their StackReference
# org segment.
# PULUMI_ORG=organization

# ── AWS deployment identity ──────────────────────────────────────
# Set before the first AWS deployment; it controls state and selected workload
# names (ECR namespace, queues, tags, cross-account deploy role, etc.).
# 1–29 lowercase letters/numbers/hyphens; must start and end alphanumeric.
# Defaults to "starter" for template compatibility. Changing it after deploy
# replaces many physical resources — use a new environment or a migration plan.
# AWS_RESOURCE_PREFIX="my-product"

# Compatibility only: legacy alias for AWS_RESOURCE_PREFIX. Prefer the canonical
# name above. If both are set they must match.
# AWS_STATE_RESOURCE_PREFIX="my-product"

# ── AWS central Pulumi state account ─────────────────────────────
# Dedicated Organization member account that stores state for every workload
# environment. CLI flags can override account/profile defaults. State resources
# are fixed to "us-east-2".
# AWS_STATE_ACCOUNT_ID="<12-digit-state-account-id>"
# AWS_STATE_PROFILE="starter-state"
# AWS_STATE_REGION="us-east-2"
# AWS_SSO_REGION="us-east-2" # Must match IAM Identity Center's actual region.

# ── AWS account-per-environment ids ──────────────────────────────
# 12-digit account id per environment. Kept OUT of git (this is a template repo);
# infra/aws/config.<env>.ts reads these via infra/aws/env.ts. Only used for
# validation/sanity-check — your credentials decide the actual deploy account.
# AWS_SANDBOX_ACCOUNT_ID="<12-digit-sandbox-account-id>"
# AWS_STAGING_ACCOUNT_ID="<12-digit-staging-account-id>"
# AWS_PRODUCTION_ACCOUNT_ID="<12-digit-production-account-id>"
# AWS_SANDBOX_PROFILE="starter-sandbox" # is optional; it defaults to starter-sandbox.

# ── AWS bootstrap stack identifiers (optional) ───────────────────
# Consumed by `pulumi config set` when standing up infra/aws/bootstrap, or paste
# directly. "owner/repo" scopes the GitHub OIDC deploy role; email enables budget
# alerts.
# AWS_GITHUB_REPO="toddwashere/starterup-starter-template-nextjs"
# AWS_BUDGET_NOTIFICATION_EMAIL="you@example.com"

# ── Vercel OIDC (hybrid Vercel <-> AWS access role) ──────────────
# Scope the cross-account role Vercel assumes via OIDC. Find the slug/project in
# your Vercel dashboard. infra/aws/config.common.ts reads these via env.ts.
# VERCEL_TEAM_SLUG=
# VERCEL_PROJECT_NAME=

# ── AWS delegated DNS + public PgBouncer allowlist ───────────────
# Real values belong only in infra/.env.local. Each individual IPv4 uses /32.
# AWS_DNS_ROOT_DOMAIN="example.com"
# AWS_POOLER_APP_EGRESS_CIDRS="203.0.113.10/32,203.0.113.11/32"
# AWS_POOLER_DEVELOPER_CIDRS="198.51.100.20/32"
