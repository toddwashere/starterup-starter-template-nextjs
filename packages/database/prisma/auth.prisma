/// Better Auth user account.
model User {
  id               String    @id @default(cuid())
  name             String
  email            String    @unique
  emailVerified    Boolean   @default(false)
  image            String?
  role             String    @default("user")
  banned           Boolean   @default(false)
  banReason        String?
  banExpires       DateTime?
  stripeCustomerId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  sessions    Session[]
  accounts    Account[]
  members     Member[]
  invitations Invitation[]

  oauthClients       OauthClient[]
  oauthAccessTokens  OauthAccessToken[]
  oauthRefreshTokens OauthRefreshToken[]
  oauthConsents      OauthConsent[]
  aiThreads          AiThread[]
}

/// Better Auth session with optional active organization context.
model Session {
  id                   String   @id @default(cuid())
  expiresAt            DateTime
  token                String   @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  activeOrganizationId String?
  impersonatedBy       String?

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  oauthAccessTokens  OauthAccessToken[]
  oauthRefreshTokens OauthRefreshToken[]

  @@index([userId])
}

/// Better Auth external identity or credential account.
model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

/// Better Auth verification token.
model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

/// Better Auth JSON Web Key Set storage.
model Jwks {
  id         String    @id @default(cuid())
  publicKey  String
  privateKey String
  createdAt  DateTime  @default(now())
  expiresAt  DateTime?

  @@map("jwks")
}

/// Better Auth organization that owns billing, members, AI threads, and credits.
model Organization {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  logo             String?
  metadata         String?
  stripeCustomerId String?
  createdAt        DateTime @default(now())

  members              Member[]
  invitations          Invitation[]
  aiThreads            AiThread[]
  creditAccount        CreditAccount?
  creditUsageEvents    CreditUsageEvent[]
  creditTopUpPurchases CreditTopUpPurchase[]
}

/// Better Auth organization membership.
model Member {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           String   @default("member")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

/// Better Auth organization invitation.
model Invitation {
  id             String   @id @default(cuid())
  organizationId String
  email          String
  role           String   @default("member")
  status         String   @default("pending")
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  inviterId      String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter      User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@index([inviterId])
}

/// Better Auth API key table mapped to lowercase `apikey`.
model Apikey {
  id                  String    @id @default(cuid())
  configId            String    @default("default")
  name                String?
  start               String?
  referenceId         String
  prefix              String?
  key                 String    @unique
  refillInterval      Int?
  refillAmount        Int?
  lastRefillAt        DateTime?
  enabled             Boolean   @default(true)
  rateLimitEnabled    Boolean   @default(true)
  rateLimitTimeWindow Int?
  rateLimitMax        Int?
  requestCount        Int       @default(0)
  remaining           Int?
  lastRequest         DateTime?
  expiresAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  permissions         String?
  metadata            String?

  @@index([referenceId])
  @@map("apikey")
}

/// OAuth client registered for public API and MCP access.
model OauthClient {
  id                      String   @id
  clientId                String   @unique
  clientSecret            String?
  name                    String?
  uri                     String?
  icon                    String?
  contacts                String[]
  tos                     String?
  policy                  String?
  softwareId              String?
  softwareVersion         String?
  softwareStatement       String?
  redirectUris            String[]
  postLogoutRedirectUris  String[]
  scopes                  String[]
  grantTypes              String[]
  responseTypes           String[]
  tokenEndpointAuthMethod String?
  type                    String?
  subjectType             String?
  public                  Boolean?
  requirePKCE             Boolean?
  skipConsent             Boolean?
  enableEndSession        Boolean?
  disabled                Boolean  @default(false)
  metadata                Json?
  referenceId             String?
  userId                  String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user          User?               @relation(fields: [userId], references: [id])
  accessTokens  OauthAccessToken[]
  refreshTokens OauthRefreshToken[]
  consents      OauthConsent[]

  @@index([userId])
  @@map("oauthClient")
}

/// OAuth access token issued to a registered client.
model OauthAccessToken {
  id          String   @id
  token       String   @unique
  clientId    String
  sessionId   String?
  userId      String?
  refreshId   String?
  referenceId String?
  scopes      String[]
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  client  OauthClient        @relation(fields: [clientId], references: [clientId])
  session Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  user    User?              @relation(fields: [userId], references: [id])
  refresh OauthRefreshToken? @relation(fields: [refreshId], references: [id])

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([refreshId])
  @@map("oauthAccessToken")
}

/// OAuth refresh token issued to a registered client.
model OauthRefreshToken {
  id          String    @id
  token       String    @unique
  clientId    String
  sessionId   String?
  userId      String
  referenceId String?
  scopes      String[]
  expiresAt   DateTime?
  revoked     DateTime?
  authTime    DateTime?
  createdAt   DateTime  @default(now())

  client       OauthClient        @relation(fields: [clientId], references: [clientId])
  session      Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  user         User               @relation(fields: [userId], references: [id])
  accessTokens OauthAccessToken[]

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@map("oauthRefreshToken")
}

/// OAuth consent granted by a user for a registered client.
model OauthConsent {
  id          String   @id
  clientId    String
  userId      String?
  referenceId String?
  scopes      String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client OauthClient @relation(fields: [clientId], references: [clientId])
  user   User?       @relation(fields: [userId], references: [id])

  @@index([clientId])
  @@index([userId])
  @@map("oauthConsent")
}
