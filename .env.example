# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/starter_dev

# Better Auth (dashboard)
BETTER_AUTH_URL=http://localhost:4000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:4000
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:4000
NEXT_PUBLIC_WWW_URL=http://localhost:4001

# Public API (base URL, no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:4002

# Public MCP (base URL, no trailing slash — port is parsed from this URL)
NEXT_PUBLIC_MCP_URL=http://localhost:4003

# OAuth (optional — app works without these)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# Email (Resend) — optional in development, required in production
# Get your API key at https://resend.com/api-keys
# RESEND_API_KEY=re_xxxxxxxxx
# EMAIL_FROM="App Name <noreply@yourdomain.com>"

# Background worker queue (apps/workers + @workspace/worker-queue)
# Transport for enqueue(): "pgmq" (default, Postgres-backed) or "sync" (tests).
WORKER_QUEUE_ADAPTER=pgmq
# Name of the pgmq queue jobs are published to / consumed from.
PGMQ_QUEUE_NAME=jobs
# Worker process: health endpoint port, poll cadence, and retry budget.
WORKER_HEALTH_PORT=4300
WORKER_POLL_INTERVAL_MS=1000
WORKER_MAX_ATTEMPTS=5

# Stripe billing (organization subscriptions via @better-auth/stripe)
# Get test-mode keys at https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_xxxxxxxx
# From `stripe listen` (see README) or the Stripe Dashboard webhook settings.
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx
# Optional: override seeded plan price IDs with real Stripe test-mode price IDs.
# STRIPE_PRICE_PRO_MONTHLY=price_xxx
# STRIPE_PRICE_PRO_ANNUAL=price_xxx
# STRIPE_PRICE_TEAM_MONTHLY=price_xxx
# Optional — only needed for future client-side Stripe Elements:
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
