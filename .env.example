# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/starter_dev"

# Better Auth (dashboard)
# Keep stable locally; changing it invalidates encrypted JWKS (run: DELETE FROM jwks;)
BETTER_AUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:4000"
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:4000"
NEXT_PUBLIC_DASHBOARD_URL="http://localhost:4000"
NEXT_PUBLIC_WWW_URL="http://localhost:4001"

# Public API (base URL, no trailing slash)
NEXT_PUBLIC_API_URL="http://localhost:4002"
# Port the public-api server listens on (default: 4002)
# PUBLIC_API_PORT=4002

# Public MCP (base URL, no trailing slash — port is parsed from this URL)
NEXT_PUBLIC_MCP_URL="http://localhost:4003"

# OAuth (optional — app works without these)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# Email (Resend) — optional in development, required in production
# Get your API key at https://resend.com/api-keys
# RESEND_API_KEY=re_xxxxxxxxx
# EMAIL_FROM="App Name <noreply@yourdomain.com>"
# EMAIL_PROVIDER=resend
# RESEND_WEBHOOK_SECRET=

# Campaigns (optional module)
# CAMPAIGN_UNSUBSCRIBE_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Background worker queue (apps/workers + @workspace/worker-queue)
# Transport for enqueue(): "bullmq" (default, Redis-backed), "pubsub" (GCP), or "sync" (tests).
WORKER_QUEUE_ADAPTER=bullmq
# Name of the BullMQ queue jobs are published to / consumed from.
BULLMQ_QUEUE_NAME=jobs
# Redis connection URL — required when WORKER_QUEUE_ADAPTER=bullmq in production.
# Optional locally: without it, enqueue() no-ops and apps/workers exits cleanly in dev.
REDIS_URL=redis://localhost:6379
# Worker process: health endpoint port, poll cadence, and retry budget.
WORKER_HEALTH_PORT=4300
WORKER_POLL_INTERVAL_MS=1000
WORKER_MAX_ATTEMPTS=5
# GCP Pub/Sub — required when WORKER_QUEUE_ADAPTER=pubsub.
# GCP_PROJECT_ID=my-gcp-project
# PUBSUB_TOPIC_NAME=jobs
# PUBSUB_SUBSCRIPTION_NAME=jobs-sub
# AWS SQS — required when WORKER_QUEUE_ADAPTER=sqs.
# SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/starter-jobs-sandbox
# AWS_REGION=us-east-1
# Azure Service Bus — required when WORKER_QUEUE_ADAPTER=servicebus.
# SERVICEBUS_CONNECTION_STRING=Endpoint=sb://starter-sb-sandbox.servicebus.windows.net/;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=...
# SERVICEBUS_QUEUE_NAME=jobs

# Stripe billing (organization subscriptions via @better-auth/stripe)
# Get test-mode keys at https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_xxxxxxxx"
# From `stripe listen` (see README) or the Stripe Dashboard webhook settings.
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxx"
# Optional: override seeded plan price IDs with real Stripe test-mode price IDs.
# STRIPE_PRICE_PRO_MONTHLY="price_xxx"
# STRIPE_PRICE_PRO_ANNUAL="price_xxx"
# STRIPE_PRICE_TEAM_MONTHLY="price_xxx"
# Optional — only needed for future client-side Stripe Elements:
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Email preview server port (default: 4004)
# EMAIL_PREVIEW_PORT=4004

# ── LLM (@workspace/ai) ─────────────────────────────────────────────────────
# Model list, presets (model + maxSteps + temperature + maxOutputTokens), and
# defaults live in packages/ai/src/ai-models-available.ts — not env.
# Set API keys for providers you use; the AI Assistant UI lists only configured providers.

# OpenRouter
# OPENROUTER_API_KEY=
# OPENROUTER_HTTP_REFERER=http://localhost:4000
# OPENROUTER_APP_NAME=starter-dev

# OpenAI direct
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic direct
# ANTHROPIC_API_KEY=

# Ollama (OpenAI-compatible)
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Generic OpenAI-compatible (LM Studio, vLLM, Together, etc.)
# AI_OPENAI_COMPAT_BASE_URL=
# AI_OPENAI_COMPAT_API_KEY=

# ── Langfuse observability (optional) ───────────────────────────────────────
# Tracing turns on only when BOTH public + secret keys are set.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ── Sentry (@workspace/observability) ───────────────────────────────────────
# Optional — leave unset in local dev. When unset the whole package no-ops
# (no SDK init, capture helpers return immediately). Enables error monitoring
# in the dashboard + www apps. NEXT_PUBLIC_SENTRY_DSN is derived from this by
# withSentryConfig — do not set it directly.
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>

# ── PostHog (@workspace/observability) ─────────────────────────────────────
# Optional — unset in local dev. Enables product analytics in dashboard + www.
# NEXT_PUBLIC_POSTHOG_TOKEN=phc_...
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── E2E tests (apps/dashboard/e2e/) ─────────────────────────────────────────
# Skip the local E2E suite (the runner exits 0 without launching a browser).
# The runner reads the process env (not this .env file), so set it inline:
#   E2E_DISABLED=1 pnpm test:e2e
